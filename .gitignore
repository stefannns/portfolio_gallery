# macOS
.DS_Store
**/.DS_Store

# Most video reels are hosted on Supabase Storage; scoped runtime exceptions are listed below.
*.mp4
*.mov
*.webm
*.mkv
web/

# vite build tooling for the /about lanyard page
about-src/node_modules/

# Any node_modules, not just about-src's. badge-portfolio/node_modules alone is 255MB, so a
# single `git add -A` without this would commit it.
node_modules/
**/node_modules/
# local vite build output; only about/ is committed, and that is written by its own build
dist/
**/dist/

# Small transparent animations required by the Farm TD game build.
!farm_td/assets/ui/fruit-quest/*.webm

# Runtime character animation clips are part of the kitchen portfolio.
!/character/**/*.mp4
!/character/**/*.webm
!/sushi/**/*.mp4
!/sushi/**/*.webm

# Local credentials and generated asset links.
.secrets/
.env
.env.*
!.env.example
kitchen-src/public/

# Supplied H3 Otome portfolio demo, served with the website.
!/videos/h3-otome-demo.mp4

# Required runtime files in checked-in downloadable templates.
!/playablebatch1/templates/**/dist/
!/playablebatch1/templates/**/dist/**
